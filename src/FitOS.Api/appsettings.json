{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=fitos;Username=fitos_app;Password=CHANGE_ME"
  },
  "Jwt": { "Issuer": "fitos", "Audience": "fitos-api", "SigningKey": "", "AccessTokenMinutes": 15 },
  "Auth": { "MaxFailedAttempts": 5, "LockoutMinutes": 15, "LoginRequestsPerMinute": 10, "IdleMinutes": 480, "SessionHours": 12 },
  "Cors": { "AllowedOrigins": [] },
  "Security": { "MaxBodyBytes": 1048576, "RequireHttps": false, "AnonymousRequestsPerMinute": 120, "AuthenticatedRequestsPerMinute": 600 },
  "Proxy": { "KnownProxies": [], "KnownNetworks": [] },
  "Secrets": { "EncryptionKey": "" },
  "Tenancy": { "BaseDomain": "fitos.com", "AllowTenantHeader": false },
  "Sicofac": { "BaseUrl": "http://localhost:8000", "AttemptTimeoutSeconds": 15 }
}
